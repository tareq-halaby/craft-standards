{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtCraft Keymap & Shortcut Definition Schema",
  "type": "object",
  "required": ["version", "bindings"],
  "properties": {
    "version": {
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "shortcut", "scope"],
        "properties": {
          "command": {
            "type": "string"
          },
          "shortcut": {
            "type": "string",
            "description": "Normalized chord, e.g. 'Cmd+0', 'Ctrl+Tab', 'Shift+Alt+W'"
          },
          "scope": {
            "type": "string",
            "enum": ["global", "document", "tool", "modal"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
